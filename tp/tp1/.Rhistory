getwd()
# Este bloque de 'setup' no mostrará la salida
# Aquí solo cargamos las librerías necesarias
library(rpart)
library(rpart.plot)
# Cargar las librerías necesarias
#install.packages("rpart", repos = 'http://cran.us.r-project.org')
#install.packages("rpart.plot", repos = 'http://cran.us.r-project.org')
library(rpart)
library(rpart.plot)
# --- PASO 1: Cargar y preparar los datos ---
# Leemos el archivo directamente desde una URL
url <- "http://archive.ics.uci.edu/ml/machine-learning-databases/adult/adult.data"
adult_df <- read.csv(url,
header = FALSE,
col.names = c("age", "workclass", "fnlwgt", "education", "education.num", "marital.status", "occupation", "relationship", "race", "sex", "capital.gain", "capital.loss", "hours.per.week", "native.country", "income"),
na.strings = "?")
# Eliminamos las filas con valores faltantes
adult_df <- na.omit(adult_df)
# Convertimos la variable 'income' en un factor, que es esencial para la clasificación.
adult_df$income <- as.factor(adult_df$income)
# PASO 2: Crear el árbol de decisión
# 'income ~ .' le dice al modelo que prediga la variable 'income'
# usando todas las otras variables del conjunto de datos.
# 'method = "class"' es para problemas de clasificación.
arbol_basico <- rpart(income ~ ., data = adult_df, method = "class")
# PASO 3: Visualizar el árbol de decisión
# 'rpart.plot' crea un gráfico claro y fácil de leer del árbol.
# 'extra = 101' agrega porcentajes en los nodos, lo que ayuda a interpretar los resultados.
rpart.plot(arbol_basico, extra = 101, main = "Mi Primer Árbol de Decisión")
